[Interface]
# ANTI VPS Control Plane Gateway
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = REPLACE_WITH_SERVER_PRIVATE_KEY

# Peer 1: Owner Mac (Trạm Cứu Hộ / Break-Glass)
[Peer]
